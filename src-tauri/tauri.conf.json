{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinLite",
  "version": "0.2.0",
  "identifier": "dev.dreamskies.winlite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "WinLite",
        "url": "index.html",
        "width": 1320,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0c0e13"
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
